# Copia a ~/.marcius3r/secrets.env y ejecuta: chmod 600 ~/.marcius3r/secrets.env
# Claude API (guiones). https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# MuAPI (backend de Open-Generative-AI) — opcional, vídeo IA sin agente. https://muapi.ai
MUAPI_API_KEY=
# ElevenLabs — opcional, voz de respaldo
ELEVENLABS_API_KEY=
# VoiceStudio local (la misma que deploy/.env)
VOICESTUDIO_API_KEY=
